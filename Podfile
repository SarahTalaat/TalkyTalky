# Uncomment the next line to define a global platform for your project
# platform :ios, '9.0'

target 'TalkyTalky' do
  # Comment the next line if you don't want to use dynamic frameworks
  use_frameworks!


  # Core Firebase SDK
  pod 'Firebase/Core'               # Includes Analytics
  pod 'Firebase/Crashlytics'        # Crash reporting
  pod 'Firebase/Performance'        # Performance monitoring
  pod 'Firebase/Analytics'          # Analytics only (if Core is not used)

  # Authentication
  pod 'Firebase/Auth'               # Email/Password, Phone, Social login

  # Database
  pod 'Firebase/Database'           # Realtime Database
  pod 'Firebase/Firestore'          # Cloud Firestore

  # Storage
  pod 'Firebase/Storage'            # Cloud Storage

  # Messaging
  pod 'Firebase/Messaging'          # Push Notifications (FCM)

  # Remote Config
  pod 'Firebase/RemoteConfig'       # A/B testing and feature toggles

  # In-App Messaging
  pod 'Firebase/InAppMessaging'     # In-app promotional messages

  # Dynamic Links
  pod 'Firebase/DynamicLinks'       # Deep linking

  # ML Kit
  pod 'Firebase/MLModelDownloader'  # ML model download manager

  # Predictions
  # pod 'Firebase/Predictions'        # AI predictions for behavior analysis

  # App Distribution
  pod 'Firebase/AppDistribution'    # Distribute beta builds

  # Other pods

  pod 'ReachabilitySwift'
  pod 'lottie-ios'
  pod 'Kingfisher'
  pod 'Alamofire'
  pod 'RxSwift', '6.5.0'
  pod 'RxCocoa', '6.5.0'
  pod 'Cosmos'

  # Pods for TalkyTalky

  target 'TalkyTalkyTests' do
    inherit! :search_paths
    # Pods for testing
  end

  target 'TalkyTalkyUITests' do
    # Pods for testing
  end

end
